# =============================================================================
# IACT-db — Configuración de infraestructura de bases de datos
# =============================================================================
# Copiar a .env y ajustar los valores antes de ejecutar bootstrap.sh
#
#   cp .env.example .env
#   sudo bash bootstrap.sh
#
# .env está en .gitignore — nunca commitear credenciales reales.
# =============================================================================

# -----------------------------------------------------------------------------
# MariaDB 11.4 — Base de datos legada (ivr_legacy, READ-ONLY para Django)
# -----------------------------------------------------------------------------
MARIADB_VERSION=10.11
DB_MARIADB_NAME=ivr_legacy
DB_MARIADB_USER=django_user
DB_MARIADB_PASSWORD=django_pass
DB_MARIADB_ROOT_PASSWORD=rootpass123
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306

# Usuario dedicado para seed histórico (schema_historico.sh PASO 1)
# Privilegios: SELECT, INSERT en tbl_historico_* y seed_executions
MARIADB_SEED_USER=ivr_seed_user
MARIADB_SEED_PASSWORD=seed_pass_ivr_2024

# Usuario dedicado para backup (backup_ivr_legacy.sh)
# Privilegios: SELECT, SHOW VIEW, TRIGGER, LOCK TABLES en ivr_legacy.*;
#              SELECT en mysql.proc y mysql.event;
#              PROCESS, RELOAD globales.
MARIADB_BACKUP_USER=ivr_backup_user
MARIADB_BACKUP_PASSWORD=backup_pass_ivr_2024

# -----------------------------------------------------------------------------
# PostgreSQL 16 — Base de datos principal (iact_analytics)
# -----------------------------------------------------------------------------
POSTGRES_VERSION=16
DB_POSTGRES_NAME=iact_analytics
DB_POSTGRES_USER=django_user
DB_POSTGRES_PASSWORD=django_pass
DB_POSTGRES_ROOT_PASSWORD=postgrespass123
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Adminer 4.8.1 — Interfaz web de administración (opcional)
# -----------------------------------------------------------------------------
ADMINER_VERSION=4.8.1
ADMINER_DOMAIN=adminer.local

# IP del servidor donde corre Adminer. Se usa como ServerAlias en Apache
# (vhost.conf y vhost_ssl.conf usan %%ADMINER_IP%% que es reemplazado por
# config.sh y ssl.sh con este valor). También se usa como IP.1 en el
# Subject Alternative Name del certificado TLS.
# Ajustar a la IP real del servidor en entornos multi-VM.
ADMINER_IP=192.168.56.12

# Puertos HTTP y HTTPS de Adminer (para show_results en bootstrap.sh)
ADMINER_HTTP_PORT=80
ADMINER_HTTPS_PORT=443

SWAP_SIZE=1G

# SSL (autofirmado para desarrollo)
SSL_DAYS=365
SSL_COUNTRY=MX
SSL_STATE=Estado
SSL_CITY=Ciudad
SSL_ORG="IACT DevBox"
SSL_OU=Development
# Common Name del certificado TLS de Adminer. Generalmente la IP o dominio.
# Requerido por adminer/ssl.sh para generar el Subject Alternative Name.
SSL_CN=192.168.56.12

# -----------------------------------------------------------------------------
# PostgreSQL — Password del superusuario del sistema
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD es el password del usuario 'postgres' del sistema
# (creado por apt install postgresql). Distinto de DB_POSTGRES_PASSWORD
# que es el password de django_user (usuario de la aplicación).
# Requerido por provisioners/postgres/config.sh (_secure_postgres).
POSTGRES_PASSWORD=postgrespass123

# -----------------------------------------------------------------------------
# Configuración general
# -----------------------------------------------------------------------------
# Zona horaria del sistema
TIMEZONE=America/Mexico_City

# Seed de datos de prueba (usado por provisioners/mariadb/schema_seed.sh)
# Número de registros a sembrar en tbl_temp_prueba_ivr
SEED_ROWS=3000

# Socket Unix de MariaDB — override para conexión root sin password (peer auth)
# Dejar comentado para auto-detección en este orden:
#   /run/mysqld/mysqld.sock  →  /var/run/mysqld/mysqld.sock  →  /tmp/mysql.sock
# Descomentar solo si el socket está en una ruta no estándar.
# Usado por provisioners/mariadb/schema_historico.sh.
# MARIADB_SOCK=/run/mysqld/mysqld.sock

# Backfill ETL manual — ejecuta sp_etl_historico para quarters históricos
# Valor 0 (default): el backfill se omite en provision-mariadb.sh
# Valor 1: PASO 7 corre sp_etl_historico para cada tbl_historico_* existente
# Uso: sudo RUN_ETL_BACKFILL=1 bash scripts/provision-mariadb.sh
#      o bien: agregar RUN_ETL_BACKFILL=1 en .env antes de ejecutar
# RUN_ETL_BACKFILL=0
